[Unit]
Description=School classroom supervision and attendance sampler
After=network-online.target school-classroom-sfu.service school-classroom-admission.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=school-classroom
Group=school-classroom
EnvironmentFile=/etc/school-classroom/watch.env
RuntimeDirectory=school-classroom-watch
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -I /opt/school-classroom/classroom-watch.py ${CLASSROOM_PREFIX} --site-path=${CLASSROOM_SITE_PATH}
ExecStopPost=/usr/bin/python3 -I /opt/school-classroom/classroom-watch.py ${CLASSROOM_PREFIX} --site-path=${CLASSROOM_SITE_PATH} --drain
WatchdogSec=16
Restart=always
RestartSec=2
TimeoutStartSec=10
TimeoutStopSec=12
TimeoutAbortSec=3
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
