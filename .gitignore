# پکیج‌های دانلودی PersianMeet (نباید در git باشند؛ هزاران فایل باینری)
*.zip
!/liveclass-install.zip
persianmeet-linux-*
/opt/

# محرمانه‌ها
.env
config.yml
*.pem
*.key

# بکاپ‌ها
/var/backups/
*.tar.gz

# پایتون
__pycache__/
*.pyc
.venv/

# سیستم
.DS_Store
Thumbs.db

# سورس اختصاصی سازنده — عمداً خارج از git
persianmeet-src/

# محیط اجرای ماژول مدیریت کلاس
classroom-manager/data/
*.db
*.db-wal
*.db-shm
secret_key

# محیط مجازی/وابستگی‌ها/داده‌ی پروژه‌ی liveclass
# (web/dist عمداً در git است تا استقرار روی سرور ضعیف بدون node انجام شود)
liveclass/.venv/
liveclass/web/node_modules/
liveclass/server/*.db
liveclass/server/data/
