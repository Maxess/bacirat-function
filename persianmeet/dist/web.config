<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <clear />
                <rule name="ReverseProxyInboundRule2" stopProcessing="true">
                    <match url="rtc.*" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{CACHE_URL}" pattern="^(https?)://" />
                    </conditions>
                    <action type="Rewrite" url="http://localhost:7880/{R:0}" appendQueryString="true" />
                </rule>
                <rule name="ReverseProxyInboundRule3" stopProcessing="true">
                    <match url="sfu(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://localhost:7880/{R:1}" />
                </rule>
                <rule name="ReverseProxyInboundRule4" enabled="true" stopProcessing="false">
                    <match url="^api(.*)" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://localhost:8000/{R:0}" appendQueryString="true" />
                </rule>
                <rule name="uploadedFile" enabled="true" stopProcessing="false">
                    <match url="^upload(.*)" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://localhost:8000/{R:0}" appendQueryString="true" />
                </rule>
                <rule name="ReverseProxyInboundRule6" stopProcessing="true">
                    <match url="wsroom(.*)" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{CACHE_URL}" pattern="^(https?)://" />
                    </conditions>

                    <action type="Rewrite" url="http://localhost:8000/{R:0}" appendQueryString="true" />
                </rule>
                <rule name="ReverseProxyInboundRule5" stopProcessing="true">
                    <match url="^room(.*)" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="/index.html" appendQueryString="true" />
                </rule>
                <rule name="ReverseProxyInboundRule7" stopProcessing="true">
                    <match url="^user(.*)" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="/index.html" appendQueryString="true" />
                </rule>
                <rule name="ReverseProxyLandingPage" stopProcessing="true">
                    <match url="planding(.*)" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="/landing.html" appendQueryString="false" />
                </rule>
                <rule name="ReverseProxyInboundRule8" stopProcessing="true">
                    <match url="^dash(.*)" />
                    <action type="Rewrite" url="/index.html" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
